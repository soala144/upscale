# Required foundation configuration
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
TELEGRAM_BOT_TOKEN_ENCRYPTION_KEY=
WATCHUP_API_KEY=

# Optional until their integration phases
ANTHROPIC_API_KEY=

# Use sk_sandbox_... with sandbox or sk_live_... with production.
# Bachs key needs payments:write, connected_accounts:read,
# and connected_accounts:write scopes.
# The platform's Bachs account must also have the connect capability enabled.
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_ENV=sandbox

# Configure one Bachs webhook endpoint at https://<public-host>/api/webhooks/bachs.
# Subscribe to collection.succeeded, collection.failed, account.updated,
# and capability.updated; use event_source "all" and store its signing secret above.
